        <mxCell id="title" value="Уровень 1 — System Context: Интернет-магазин" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="customer" value="&lt;b&gt;Покупатель&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Просматривает каталог и оформляет заказы" style="shape=mxgraph.c4.person2;labelPosition=center;verticalLabelPosition=middle;align=center;verticalAlign=bottom;spacingBottom=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="70" width="230" height="140" as="geometry"/></mxCell>
        <mxCell id="manager" value="&lt;b&gt;Менеджер магазина&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Добавляет товары и следит за остатками" style="shape=mxgraph.c4.person2;labelPosition=center;verticalLabelPosition=middle;align=center;verticalAlign=bottom;spacingBottom=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="70" width="230" height="140" as="geometry"/></mxCell>
        <mxCell id="shop" value="&lt;b&gt;Интернет-магазин&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Каталог товаров, оформление заказов с резервированием на складе и оплатой" style="rounded=1;arcSize=8;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="360" width="440" height="160" as="geometry"/></mxCell>
        <mxCell id="e0" value="Смотрит каталог, оформляет заказы&lt;br&gt;[HTTP/JSON]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#707070;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#404040;" edge="1" parent="1" source="customer" target="shop"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="Управляет товарами и остатками&lt;br&gt;[HTTP/JSON]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#707070;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#404040;" edge="1" parent="1" source="manager" target="shop"><mxGeometry relative="1" as="geometry"/></mxCell>
